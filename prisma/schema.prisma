generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workout {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  userId    String
  exercises Exercise[]
} 

model Exercise {
  id        String  @id @default(cuid())
  name      String
  sets      Int
  reps      Int
  workoutId String
  weight    Int
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
}
